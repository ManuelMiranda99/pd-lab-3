# Variables de entorno de NovaPedidos.
# Copia este archivo a `.env` (cp .env.example .env) y completa la clave.
# `.env` está en .gitignore: nunca lo subas al repo ni lo copies a imágenes.

# Clave de OpenRouter (https://openrouter.ai/keys). Obligatoria para usar el intérprete LLM.
OPENROUTER_API_KEY=

# Modelo de OpenRouter que usa el servicio. El evaluador usa ESTE valor con su propia clave.
# Elegido tras comparar 6 modelos en calidad, latencia y costo (DECISIONES.md D49,
# evidencia/comparacion/comparacion.md): 177/177 casos, p95 ≈ 1.1 s, ≈ USD 0.0002 por pedido.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Razonamiento del modelo (opcional): vacío = el del proveedor (gemini-2.5-flash-lite no razona
# por defecto); "no" lo apaga; minimal/low/medium/high fijan el esfuerzo. Solo para modelos
# que razonan (p. ej. google/gemini-2.5-flash con "no").
OPENROUTER_RAZONAMIENTO=

# Endpoint compatible con OpenAI de OpenRouter (normalmente no se cambia).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Servidor de MLflow (trazas y evaluación). En Docker Compose la API usa http://mlflow:5000
# (lo fija docker-compose.yml); este valor es para correr la API o la evaluación fuera de Docker.
# Si MLflow no responde, la API sigue funcionando y /health reporta "degradado".
MLFLOW_TRACKING_URI=http://localhost:5000

# Experimentos de MLflow: trazas de cada solicitud de la API y runs de evaluación
# (`uv run python eval/correr.py ... --mlflow`). Se crean solos si no existen.
MLFLOW_EXPERIMENTO_API=novapedidos-api
MLFLOW_EXPERIMENTO_EVAL=novapedidos-evaluacion

# Trazar cada solicitud de la API en MLflow (true/false). Con MLFLOW_TRACKING_URI vacía no se traza.
MLFLOW_TRAZAS=true

# Opcional (avanzado): la API ya fija estos valores por defecto para que MLflow caído o colgado
# no frene las respuestas (DECISIONES.md D43). Solo hace falta definirlos para cambiarlos, y
# deben ser variables de entorno reales: no se leen de este .env al correr con uv. En Docker
# Compose sí (`env_file`); docker-compose.yml ya las define con estos valores.
# MLFLOW_HTTP_REQUEST_TIMEOUT=3
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=1
# MLFLOW_ASYNC_TRACE_LOGGING_MAX_QUEUE_SIZE=200
# MLFLOW_ASYNC_TRACE_LOGGING_MAX_WORKERS=4

# Carpeta con los parquet publicados (productos, sinonimos, precios_escala, clientes,
# historial_pedidos). Fuera del repo; en Docker se monta ./datos (o DATOS_HOST_DIR) como volumen
# de solo lectura en /app/datos.
DATOS_DIR=datos

# Intérprete de mensajes de la API: "llm" (LangChain + OpenRouter, el de producción) o "falso"
# (tabla fija con el ejemplo del Anexo, solo para demos y pruebas sin clave).
INTERPRETE=llm
